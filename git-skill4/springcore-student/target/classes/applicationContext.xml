        <property name="url" value="jdbc:mysql://localhost:3306/studentdb"/>
        <property name="username" value="root"/>
        <property name="password" value="Kl@2439552"/>
    </bean>

    <bean id="course" class="com.klu.Course">
        <constructor-arg value="FSAD"/>
        <constructor-arg value="6"/>
    </bean>

    <bean id="student" class="com.klu.Student">
        <constructor-arg value="102"/>
